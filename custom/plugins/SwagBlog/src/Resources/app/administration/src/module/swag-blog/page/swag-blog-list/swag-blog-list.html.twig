{% block swag_blog_list %}
    {% block swag_blog_list_smart_bar_actions %}
        <template #smart-bar-actions>
            <sw-button variant="primary" :routerLink="{ name: 'swag.blog.create' }">
                {{ $tc('swag.blog.list.addButtonText')}}                
            </sw-button>
        </template>
    {% endblock %}

    <template #content>
        {% block swag_blog_list_content %}
            <sw-entity-listing 
            v-if="blogs"
            :items="blogs"
            :repository="repository"
            :showSelection="false"
            :columns="columns"
            detailRoute="swag.blog.detail">
            </sw-entity-listing>
        {% endblock %}
    </template>
{% endblock %}