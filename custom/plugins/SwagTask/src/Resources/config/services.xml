<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="Task\Core\Content\Swag\SwagDefinition">
            <tag name="shopware.entity.definition" entity="swag" />
        </service>

        <service id="Task\Core\Content\Swag\Aggregate\TaskTranslationDefinition">
            <tag name="shopware.entity.definition" entity="swag_translation" />
        </service>


        <!-- Extensions -->
        <service id="Task\Core\Content\Extension\CountryExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="Task\Core\Content\Extension\CountryStateExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="Task\Core\Content\Extension\MediaExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="Task\Core\Content\Extension\ProductExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="Task\Core\Content\Extension\LanguageExtension">
            <tag name="shopware.entity.extension" />
        </service>

    </services>
</container>